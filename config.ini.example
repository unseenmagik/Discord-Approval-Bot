; Copy this file to config.ini and fill in the values.
; To copy an ID in Discord: User Settings > Advanced > Developer Mode, then right-click > Copy ID.
; Lists are comma-separated, e.g. 111111111111111111, 222222222222222222

[bot]
token =
guild_id =

[roles]
; Roles that count as "verified".
;  - A referrer must hold at least one of these for the referral to be accepted.
;  - Members who already hold one of these (or the approved role) cannot verify again.
verified_role_ids =
; Role given to a member when they are approved. Usually also listed in verified_role_ids.
approved_role_id =
; Optional: members must hold one of these roles to use the Verify button (e.g. your Ko-fi role).
; Leave blank to allow anyone who can see the panel.
required_role_ids =

[admin]
; Users and/or roles allowed to use the admin slash commands and admin buttons.
admin_user_ids =
admin_role_ids =

[channels]
; Where /verify-panel posts the verification panel by default.
welcome_channel_id =
; Admin-only channel for approval notices and lockout alerts.
admin_channel_id =

[notifications]
; Tagged when a member uses all their attempts and needs manual help.
lockout_mention_user_ids =
lockout_mention_role_ids =
; Tagged when a member is approved automatically.
approval_mention_user_ids =
approval_mention_role_ids =

[verification]
; Failed attempts allowed before the member is locked and admins are alerted.
max_attempts = 3
; Paths are relative to the folder this config file is in.
referrers_file = referrers.json
database_file = data/approvals.db

[panel]
title = Verify your referral
; Use \n for a new line.
description = Welcome! To unlock the rest of the server, tell us who referred you.\n\nPress **Verify** and enter your referrer's **Discord username** or **user ID**. If you don't know it, enter their **name** instead.
embed_color = 0x5865F2
