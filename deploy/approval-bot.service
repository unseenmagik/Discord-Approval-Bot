# systemd unit for the Discord Approval Bot.
# Install: sudo cp deploy/approval-bot.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now approval-bot
# Adjust User and the paths if you installed somewhere other than /opt/discord-approval-bot.

[Unit]
Description=Discord Approval Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=approvalbot
Group=approvalbot
WorkingDirectory=/opt/discord-approval-bot
ExecStart=/opt/discord-approval-bot/.venv/bin/python bot.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

# Hardening: the bot only needs to write inside its own folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/discord-approval-bot

[Install]
WantedBy=multi-user.target
