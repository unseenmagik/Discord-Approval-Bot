# systemd user unit for the Discord Approval Bot (no root needed).
# Install: mkdir -p ~/.config/systemd/user && cp deploy/approval-bot.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now approval-bot
#          loginctl enable-linger   # keep it running after logout and start on boot
# %h is your home directory. Adjust the paths if you installed somewhere other than ~/discord-approval-bot.

[Unit]
Description=Discord Approval Bot

[Service]
Type=simple
WorkingDirectory=%h/discord-approval-bot
ExecStart=%h/discord-approval-bot/.venv/bin/python bot.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
